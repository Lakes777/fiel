{
  "name": "fiel-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Interface do Fiel (fase 8): tela inicial, carteira e painel do lojista",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "tipos": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.ts\"",
    "format:conferir": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
